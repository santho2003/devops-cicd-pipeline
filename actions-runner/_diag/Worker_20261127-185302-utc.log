              "line": 114,
              "col": 14,
              "lit": "$healthy = $false\n\nfor ($i = 1; $i -le 20; $i++) {\n    try {\n        $response = Invoke-RestMethod `\n            -Uri \"http://localhost:5000/health\" `\n            -TimeoutSec 3\n\n        if ($response.status -eq \"healthy\") {\n            Write-Host \"Deployment health check passed!\"\n            $healthy = $true\n            break\n        }\n    }\n    catch {\n        Write-Host \"Waiting for application... Attempt $i\"\n    }\n\n    Start-Sleep -Seconds 2\n}\n\nif (-not $healthy) {\n    docker compose logs\n    throw \"Deployment health check failed!\"\n}\n"
            }
          },
